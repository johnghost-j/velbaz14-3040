# ─────────────────────────────────────────────────────────────────────────────
# Velbaz — modèle de configuration.
#
# Copier en `.env` À LA RACINE (un seul fichier : jamais .env.local / .env.production).
# Les clés COMMENTÉES sont optionnelles : la fonctionnalité se désactive
# proprement si elles sont vides, elle ne simule jamais un résultat.
#
# [ADMIN] = à saisir plutôt depuis Admin Panel → API Keys (stockage chiffré en
#           base, prise en compte immédiate, aucun redémarrage). Pas besoin de
#           l'écrire ici.
# [ENV]   = lue seulement dans process.env → doit être ici + redémarrage.
#
# Détail de l'effet de chaque clé manquante : voir MIGRATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ REQUIS — l'app ne fonctionne pas sans ═══════════════════════════════════

# Environnement
NODE_ENV=development
WEBSITE_URL=http://localhost:4200
APPLICATION_ID=

# Better Auth — sessions / authentification
BETTER_AUTH_SECRET=

# Base de données (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Passerelle IA — tous les agents
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Paiements plateforme / suivi
AUTUMN_SECRET_KEY=

# Stockage fichiers (Tigris) — upload
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Fournis par Runable à l'import — NE PAS écrire en dur
VITE_RUNABLE_AUTH_ISSUER=
VITE_APPLICATION_ID=
RUNABLE_URL=

# ═══ CLÉS OPTIONNELLES — une par outil ═══════════════════════════════════════
# AUCUNE n'est obligatoire. À saisir plutôt dans Admin Panel → API Keys
# (chiffré, effet immédiat). Liste expliquée : API-KEYS.md.
# IA, hébergement, domaines : AUCUNE clé (passerelle Runable / Hostinger).

# Stripe — vrais paiements
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend — e-mails
# RESEND_API_KEY=
# RESEND_FROM=

# Printify — print-on-demand réel (les produits sont VRAIMENT créés/publiés)
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=

# Higgsfield — images & vidéos
# HF_API_KEY=
# HF_API_SECRET=

# Replicate — upscale IA (sans : upscale local sharp)
# REPLICATE_API_TOKEN=

# 21st.dev — composants premium du builder
# TWENTY_FIRST_API_KEY=

# Firecrawl — scraping / clonage de sites
# FIRECRAWL_API_KEY=

# OpenRouter — modèles non filtrés uniquement
# OPENROUTER_API_KEY=

# GitHub — export de projets
# GITHUB_TOKEN=
# GITHUB_OWNER=

# Sentry — surveillance des erreurs
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Google — bouton « Continuer avec Google »
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Bland.ai — appels IA + SMS du Growth Engine (sans : mode démo)
# BLAND_FROM = numéro acheté chez Bland, obligatoire pour les SMS (US/Canada)
# BLAND_API_KEY=
# BLAND_FROM=

# Réseaux sociaux — connexion & publication
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# ═══ RÉGLAGES (ce ne sont PAS des clés — défauts déjà corrects) ══════════════

# Accès admin. Défaut dans le code : johnemadmansour1@gmail.com.
# Pour ajouter d'autres e-mails (virgules) — lu au démarrage.
# ADMIN_EMAILS=
# Clé de chiffrement du coffre (repli : BETTER_AUTH_SECRET)
# SECRET_STORE_KEY=
# Liste d'attente : vide/0 = ouvert à tous (défaut), 1 = landing liste d'attente
# VELBAZ_WAITLIST=0
# Codes bêta (défaut BETA_PUBLIC_CODE : VELBAZ-BETA)
# BETA_PUBLIC_CODE=
# BETA_ADMIN_CODE=
# BETA_MAX_TESTERS=
# 1 = désactive l'auto-réparation
# SELFHEAL_DISABLED=
# Publication X en direct
# X_LIVE_ENABLED=
# Bases d'URL (sinon déduites de WEBSITE_URL / de la requête)
# PUBLIC_BASE_URL=
# GOOGLE_REDIRECT_BASE=
# OAUTH_REDIRECT_BASE=
# OAUTH_STATE_SECRET=
# Serveur de contrôle Velbaz perso (télémétrie) — seulement si tu en as un
# INGEST_API_KEY=
# VELBAZ_CONTROL_BASE_URL=
